{
  "title": "Heart Disease API",
  "uid": "heart-api",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests per second",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"refId": "A", "legendFormat": "{{path}} {{status}}",
        "expr": "sum by (path, status) (rate(api_requests_total[1m]))"}]
    },
    {
      "id": 2, "type": "timeseries", "title": "p95 latency of /predict (seconds)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"refId": "A", "legendFormat": "p95",
        "expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_duration_seconds_bucket{path=\"/predict\"}[1m])))"}]
    },
    {
      "id": 3, "type": "stat", "title": "API pods up",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 4, "x": 0, "y": 8},
      "targets": [{"refId": "A", "expr": "count(up{job=\"heart-api\"} == 1)"}]
    },
    {
      "id": 4, "type": "stat", "title": "Server error rate (5xx)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 4, "x": 4, "y": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "targets": [{"refId": "A",
        "expr": "(sum(rate(api_requests_total{status=~\"5..\"}[1m])) or vector(0)) / sum(rate(api_requests_total[1m]))"}]
    },
    {
      "id": 5, "type": "stat", "title": "Average prediction confidence",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 4, "x": 8, "y": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1, "min": 0}, "overrides": []},
      "targets": [{"refId": "A",
        "expr": "sum(rate(api_prediction_confidence_sum[5m])) / sum(rate(api_prediction_confidence_count[5m]))"}]
    },
    {
      "id": 6, "type": "timeseries", "title": "Predictions by class (per minute)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 8},
      "targets": [{"refId": "A", "legendFormat": "{{label}}",
        "expr": "sum by (label) (increase(api_predictions_total[1m]))"}]
    }
  ]
}